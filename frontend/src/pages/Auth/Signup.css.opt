/* === SIGNUP CONTAINER === */
.signup-container {
  display: flex;
  height: 100vh;
  width: 100vw;
  background-color: #fffaf3;
  font-family: "Poppins", sans-serif;
  overflow: hidden;
}

/* === LEFT SECTION === */
.signup-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 10px 25px;
  min-width: 0;
  overflow: hidden;
}

/* Hide scrollbar */
.signup-left::-webkit-scrollbar {
  width: 0px;
  background: transparent;
}
.signup-left {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.logo {
  font-size: 22px;
  font-weight: 700;
  color: #004d40;
  margin-bottom: 5px;
}

h2 {
  font-weight: 600;
  margin-bottom: 10px;
  color: #222;
  font-size: 16px;
}

/* === MAIN CONTENT === */
.main-content {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* === FORM STYLING === */
form {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 340px;
}

form input {
  margin: 5px 0;
  padding: 11px 12px;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  font-size: 13px;
  font-family: "Poppins", sans-serif;
  outline: none;
  background-color: #fafafa;
  transition: all 0.25s ease-in-out;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

form input:focus {
  border-color: #00897b;
  background-color: #fff;
  box-shadow: 0 0 5px rgba(0, 137, 123, 0.3);
}

::placeholder {
  color: #9e9e9e;
  font-size: 12px;
}

.terms {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-top: 3px;
  font-size: 12px;
  color: #444;
}

.terms .link {
  color: #00897b;
  font-weight: 600;
  cursor: pointer;
}

.signup-btn {
  background-color: #004d40;
  color: #fff;
  font-weight: 600;
  border: none;
  border-radius: 8px;
  padding: 11px;
  cursor: pointer;
  margin-top: 6px;
  transition: all 0.25s ease-in-out;
}

.signup-btn:hover {
  background-color: #00695c;
  transform: translateY(-1px);
}

.or-text {
  text-align: center;
  margin: 10px 0 6px 0;
  color: #666;
  font-size: 12px;
}

.social-icons {
  display: flex;
  justify-content: center;
  gap: 12px;
}

.social-icons img {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: none;
  padding: 0;
  cursor: pointer;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  box-shadow: none;
  object-fit: contain;
  mix-blend-mode: normal !important;
  filter: none !important;
}

.social-icons img:hover {
  transform: scale(1.1);
  box-shadow: 0 3px 8px rgba(0, 137, 123, 0.25);
}

/* === SIGNIN TEXT === */
.signin-text {
  text-align: center;
  margin: 0 0 8px 0;
  font-size: 12px;
  color: #444;
}

.signin-link {
  color: #00897b;
  font-weight: 600;
  cursor: pointer;
}

.signin-link:hover {
  text-decoration: underline;
}

/* === RIGHT SECTION === */
.signup-right {
  flex: 1;
  background-color: #fff5e5;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-top-left-radius: 60px;
  overflow: hidden;
  padding: 15px;
  min-width: 0;
}

.signup-right img {
  width: 65%;
  border-radius: 14px;
  object-fit: cover;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

.info-box {
  text-align: center;
  margin-top: 12px;
  max-width: 300px;
}

.info-box h3 {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 6px;
  color: #004d40;
}

.info-box p {
  font-size: 13px;
  color: #333;
  line-height: 1.4;
}

/* Responsive */
@media (max-width: 900px) {
  .signup-container {
    flex-direction: column;
    overflow-y: auto;
    height: auto;
    min-height: 100vh;
  }
  
  .signup-left {
    padding: 15px 25px;
    flex: none;
    overflow-y: visible;
  }
  
  .signup-right {
    max-height: 35vh;
    border-top-left-radius: 35px;
    flex: none;
    height: auto;
  }
  
  .signup-right img {
    width: 55%;
  }
}
